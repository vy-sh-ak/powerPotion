<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <AssemblyTitle>PowerPotion Host</AssemblyTitle>
    <Product>PowerPotion</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\powerpotion.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Location of the installed third-party rendering engine product. -->
    <EngineDir Condition="'$(EngineDir)'==''">C:\Program Files\Enscape\RendererHost</EngineDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerPotion.Protocol\PowerPotion.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" />
  </ItemGroup>

  <!--
    The rendering engine is used at RUNTIME from the locally installed (licensed) renderer product.
    These compile-time references are NOT redistributed: Private=false keeps them out of our output,
    and at runtime EngineBridge loads them from the engine install directory.
  -->
  <ItemGroup>
    <Reference Include="Enscape.RendererApi">
      <HintPath>$(EngineDir)\Enscape.RendererApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GlmSharpStd">
      <HintPath>$(EngineDir)\GlmSharpStd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="EnsureEngineApi" BeforeTargets="ResolveAssemblyReferences" Condition="'$(EngineDir)'==''">
    <Error Text="Enscape.RendererApi.dll not found. Set EngineDir property to the renderer host directory (default C:\Program Files\Enscape\RendererHost)." Condition="!Exists('C:\Program Files\Enscape\RendererHost\Enscape.RendererApi.dll')" />
  </Target>
</Project>
