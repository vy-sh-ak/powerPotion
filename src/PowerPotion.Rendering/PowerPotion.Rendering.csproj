<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyTitle>PowerPotion Rendering</AssemblyTitle>
    <Product>PowerPotion</Product>
    <Version>0.2.0</Version>
    <ShaderSourceDir>$(MSBuildThisFileDirectory)Shaders</ShaderSourceDir>
    <ShaderOutputDir>$(ShaderSourceDir)\Compiled</ShaderOutputDir>
    <ShaderStamp>$(ShaderOutputDir)\.stamp</ShaderStamp>
    <ShaderCompilerAssembly>$(MSBuildThisFileDirectory)..\..\tools\ShaderCompiler\bin\$(Configuration)\net8.0\ShaderCompiler.dll</ShaderCompilerAssembly>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerPotion.Protocol\PowerPotion.Protocol.csproj" />
    <!--
      ShaderCompiler is a solution project, so it is already built by the solution build.
      Reference it so MSBuild orders it before this project instead of letting the
      CompileShaders target run a nested `dotnet run` build of the same project.
    -->
    <ProjectReference Include="..\..\tools\ShaderCompiler\ShaderCompiler.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SetConfiguration="Configuration=$(Configuration)"
                      SetPlatform="Platform=AnyCPU" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Vulkan" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.22.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>

  <ItemGroup>
    <ShaderSource Include="$(ShaderSourceDir)\**\*.vert;$(ShaderSourceDir)\**\*.frag;$(ShaderSourceDir)\**\*.comp" />
    <EmbeddedResource Include="$(ShaderOutputDir)\**\*.spv" />
  </ItemGroup>

  <!--
    Build-time shader compilation: GLSL -> SPIR-V with shaderc. The generated .spv files are
    committed so the renderer has no runtime shaderc dependency; the target refreshes them when
    a shader source changes.
  -->
  <Target Name="CompileShaders" BeforeTargets="PrepareResources" Inputs="@(ShaderSource)" Outputs="$(ShaderStamp)" Condition="'$(POWERPOTION_SKIP_SHADER_BUILD)' != '1'">
    <Exec Command="dotnet &quot;$(ShaderCompilerAssembly)&quot; &quot;$(ShaderSourceDir)&quot; &quot;$(ShaderOutputDir)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)..\.." />
    <Touch Files="$(ShaderStamp)" AlwaysCreate="true" />
  </Target>
</Project>
