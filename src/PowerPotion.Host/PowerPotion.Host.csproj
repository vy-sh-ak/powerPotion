<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <AssemblyTitle>PowerPotion Host</AssemblyTitle>
    <Product>PowerPotion</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Location of the installed Enscape product that provides the rendering engine. -->
    <EnscapeDir Condition="'$(EnscapeDir)'==''">C:\Program Files\Enscape\RendererHost</EnscapeDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerPotion.Protocol\PowerPotion.Protocol.csproj" />
  </ItemGroup>

  <!--
    The Enscape engine is used at RUNTIME from the locally installed (licensed) Enscape product.
    These compile-time references are NOT redistributed: Private=false keeps them out of our output,
    and at runtime EngineBridge loads them from the Enscape install directory.
  -->
  <ItemGroup>
    <Reference Include="Enscape.RendererApi">
      <HintPath>$(EnscapeDir)\Enscape.RendererApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GlmSharpStd">
      <HintPath>$(EnscapeDir)\GlmSharpStd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="EnsureEnscapeApi" BeforeTargets="ResolveAssemblyReferences" Condition="'$(EnscapeDir)'==''">
    <Error Text="Enscape.RendererApi.dll not found. Set EnscapeDir property to the Enscape RendererHost directory (default C:\Program Files\Enscape\RendererHost)." Condition="!Exists('C:\Program Files\Enscape\RendererHost\Enscape.RendererApi.dll')" />
  </Target>
</Project>
