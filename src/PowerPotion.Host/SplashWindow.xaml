<Window x:Class="PowerPotion.Host.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Power Potion"
        Width="460" Height="310"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Border Background="#F2140B22" BorderBrush="#6D4EA6" BorderThickness="1" CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.65" Color="#000000"/>
        </Border.Effect>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="Assets/logo256.png" Width="120" Height="120"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Power Potion" FontSize="28" FontWeight="Bold" Foreground="#B388FF"
                       HorizontalAlignment="Center" Margin="0,14,0,2"/>
            <TextBlock Text="L I V E   R E N D E R E R   F O R   R E V I T" FontSize="9.5"
                       Foreground="#A996C9" HorizontalAlignment="Center"/>
            <Grid Width="210" Height="3.5" Margin="0,22,0,0">
                <Border Background="#2E1B47" CornerRadius="2"/>
                <Border Width="68" Height="3.5" Background="#B388FF" CornerRadius="2" HorizontalAlignment="Left">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="BarTransform" X="-68"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>
            <TextBlock x:Name="StatusLine" Text="Starting renderer…" Foreground="#D8CCF0" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
        </StackPanel>
    </Border>
</Window>
